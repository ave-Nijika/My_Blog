NODE_ENV=development

# ⚠️ APP_URL 必须等于实际访问源（协议+域名+端口），例如：
#    本地开发   APP_URL=http://localhost:3000
#    生产环境   APP_URL=https://blog.example.com
#    不一致时后台登录会静默 403（登录 Origin 校验 fail-closed 设计）
APP_URL=http://localhost:3000

# 数据库（本地开发用 SQLite，生产用 PostgreSQL）
# 本地开发：DATABASE_URL=file:./dev.db（迁移：pnpm prisma migrate deploy）
# 生产环境：DATABASE_URL=postgresql://bloguser:${POSTGRES_PASSWORD}@postgres:5432/blogdb
#           迁移使用 PG 版 schema：pnpm db:migrate:pg（等价于 prisma migrate deploy --schema prisma/pg/schema.prisma）
DATABASE_URL=file:./dev.db

# PostgreSQL 生产环境密码（用于 docker-compose.prod.yml）
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# 管理员登录与安全密钥（生产环境必须替换为强随机值；未设置/仍是占位值时生产环境拒绝启动）
ADMIN_LOGIN_PATH=/private-admin-login
IP_HASH_SECRET=replace-with-a-long-random-secret
VISITOR_TOKEN_SECRET=replace-with-a-long-random-secret

# 可信代理网段（逗号分隔 CIDR）。仅在配置了该列表时，应用才采信 nginx 传来的
# X-Forwarded-For；否则一律视为直连（XFF 不可信）。nginx 已配置为覆盖式传递。
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# 上传目录（文件上传功能未实现，变量暂不生效）
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_BYTES=5242880

# 验证码（未配置密钥前使用 Mock Provider）
# 注意：NEXT_PUBLIC_* 在构建期内联，Docker 构建时需经 build-arg 传入
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=mock
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_EXPECTED_HOSTNAME=
CAPTCHA_EXPECTED_ACTION=comment

# 评论（除限流两项外，均可在后台"站点设置"中覆盖，DB 优先）
COMMENT_COOLDOWN_SECONDS=600
COMMENT_MIN_LENGTH=2
COMMENT_MAX_LENGTH=2000
COMMENT_BODY_MAX_BYTES=10000
COMMENT_AUTO_BAN_THRESHOLD=3
COMMENT_RATE_LIMIT_WINDOW_SECONDS=60
COMMENT_RATE_LIMIT_MAX_ATTEMPTS=3

# LLM 评论审核（默认关闭）
COMMENT_LLM_ENABLED=false
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
COMMENT_LLM_TIMEOUT_MS=10000
COMMENT_LLM_MAX_RETRIES=2

LOG_LEVEL=info
